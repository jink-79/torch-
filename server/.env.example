# Copy to server/.env (git-ignored) and fill in. Never commit real values.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers). Include the database name, e.g. /torch
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/torch?retryWrites=true&w=majority

# Signs session cookies. At least 32 chars. Generate with:  openssl rand -base64 48
JWT_SECRET=

# Where the web app is served from. Required in production; state-changing requests from any other origin get 403.
# APP_ORIGIN=https://your-app.vercel.app

PORT=4000
# How long a sign-in lasts.
SESSION_HOURS=168
# Number of proxy hops in front of the server (1 on Render/Railway/behind a load balancer, 0 locally).
TRUST_PROXY=0
# true = also serve the built client (client/dist) from this server, same origin.
SERVE_CLIENT=false
